# СБИС / Saby — все три параметра обязательны и относятся к одному приложению.
# ID подключения (app_client_id) из карточки приложения в «Подключениях к Saby».
SBIS_APP_CLIENT_ID=
# Защищённый ключ приложения (app_secret) из той же карточки.
SBIS_APP_SECRET=
# Значение сервисного ключа (secret_key) из скачанного файла, а не имя файла.
SBIS_SECRET_KEY=

# Диадок — все три параметра обязательны; access token клиент получает автоматически.
# ID приложения (client_id) из Кабинета интегратора Контур.
DIADOC_CLIENT_ID=
# API-ключ приложения (client_secret) из Кабинета интегратора.
DIADOC_CLIENT_SECRET=
# Refresh token, выпущенный в Кабинете интегратора для технической учётной записи.
DIADOC_REFRESH_TOKEN=

# 1С — URL, логин и пароль обязательны.
# Корневой URL существующей стандартной OData-публикации по HTTPS,
# например https://onec.example.org/base/odata/standard.odata/ (без логина и пароля в URL).
ONEC_ODATA_URL=
# Логин любой учётной записи 1С с правами на нужные операции.
ONEC_ODATA_USERNAME=
# Пароль этой учётной записи 1С.
ONEC_ODATA_PASSWORD=
# Необязательно: 0 — HTTP запрещён (по умолчанию), 1 — разрешён только для тестовой базы.
ONEC_ODATA_ALLOW_HTTP=0

# PaddleOCR — URL и ключ обязательны; ключ передаётся в X-API-Key.
OCR_API_URL=
OCR_API_KEY=

# Сетевая папка SMB — все параметры обязательны, значений по умолчанию нет.
NETWORK_FOLDER_PATH=
NETWORK_FOLDER_USERNAME=
NETWORK_FOLDER_PASSWORD=
